{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Marimekko (mosaic) chart. Each band is a road user type; band height shows how many people of that type were involved in injury crashes, and the coloured segments show what happened to them.",
  "width": "container",
  "height": 400,
  "padding": {
    "left": 0,
    "right": 0,
    "top": 6,
    "bottom": 4
  },
  "data": {
    "url": "data/user_outcome.csv"
  },
  "transform": [
    {
      "calculate": "indexof(['Motorcyclist','Pedestrian','Cyclist','Passenger','Driver'], datum.road_user)",
      "as": "user_order"
    },
    {
      "calculate": "indexof(['Killed','Seriously injured','Other injury','Not injured'], datum.outcome)",
      "as": "outcome_order"
    },
    {
      "stack": "people",
      "groupby": [],
      "as": [
        "ya",
        "yb"
      ],
      "offset": "normalize",
      "sort": [
        {
          "field": "user_order",
          "order": "ascending"
        },
        {
          "field": "outcome_order",
          "order": "ascending"
        }
      ]
    },
    {
      "window": [
        {
          "op": "min",
          "field": "ya",
          "as": "y"
        },
        {
          "op": "max",
          "field": "yb",
          "as": "y2"
        }
      ],
      "groupby": [
        "road_user"
      ],
      "frame": [
        null,
        null
      ]
    },
    {
      "window": [
        {
          "op": "dense_rank",
          "as": "user_rank"
        }
      ],
      "sort": [
        {
          "field": "user_order",
          "order": "ascending"
        }
      ],
      "frame": [
        null,
        null
      ]
    },
    {
      "stack": "people",
      "groupby": [
        "road_user"
      ],
      "as": [
        "x",
        "x2"
      ],
      "offset": "normalize",
      "sort": [
        {
          "field": "outcome_order",
          "order": "ascending"
        }
      ]
    },
    {
      "calculate": "datum.y + (datum.user_rank - 1) * 0.014",
      "as": "ny"
    },
    {
      "calculate": "datum.y2 + (datum.user_rank - 1) * 0.014",
      "as": "ny2"
    },
    {
      "calculate": "datum.outcome == 'Killed' || datum.outcome == 'Seriously injured' ? datum.people : 0",
      "as": "ksi_people"
    },
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "people",
          "as": "user_total"
        }
      ],
      "groupby": [
        "road_user"
      ]
    },
    {
      "calculate": "{'Driver':'Drivers','Passenger':'Passengers','Motorcyclist':'Motorcyclists','Pedestrian':'Pedestrians','Cyclist':'Cyclists'}[datum.road_user]",
      "as": "group"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "rect",
        "stroke": "#F6F6F4",
        "strokeWidth": 1
      },
      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative",
          "title": null,
          "scale": {
            "domain": [
              0,
              1
            ]
          },
          "axis": {
            "format": "%",
            "values": [
              0,
              0.25,
              0.5,
              0.75,
              1
            ],
            "orient": "top",
            "ticks": false,
            "domain": false,
            "grid": false
          }
        },
        "x2": {
          "field": "x2"
        },
        "y": {
          "field": "ny",
          "type": "quantitative",
          "axis": null,
          "scale": {
            "domain": [
              0,
              1.056
            ],
            "reverse": true,
            "nice": false
          }
        },
        "y2": {
          "field": "ny2"
        },
        "color": {
          "field": "outcome",
          "type": "nominal",
          "title": null,
          "scale": {
            "domain": [
              "Killed",
              "Seriously injured",
              "Other injury",
              "Not injured"
            ],
            "range": [
              "#7F1520",
              "#D04A2F",
              "#F2B49A",
              "#DADDD8"
            ]
          },
          "legend": {
            "orient": "bottom",
            "direction": "horizontal",
            "symbolType": "square",
            "offset": 12
          }
        },
        "tooltip": [
          {
            "field": "group",
            "title": "Road user"
          },
          {
            "field": "outcome",
            "title": "Outcome"
          },
          {
            "field": "people",
            "title": "People",
            "format": ","
          },
          {
            "field": "user_total",
            "title": "All involved",
            "format": ","
          }
        ]
      }
    },
    {
      "transform": [
        {
          "aggregate": [
            {
              "op": "min",
              "field": "ny",
              "as": "y0"
            },
            {
              "op": "max",
              "field": "ny2",
              "as": "y1"
            },
            {
              "op": "sum",
              "field": "people",
              "as": "total"
            },
            {
              "op": "sum",
              "field": "ksi_people",
              "as": "ksi"
            }
          ],
          "groupby": [
            "group"
          ]
        },
        {
          "calculate": "(datum.y0 + datum.y1) / 2",
          "as": "yc"
        },
        {
          "calculate": "datum.ksi / datum.total",
          "as": "ksi_share"
        },
        {
          "calculate": "format(datum.total, ',') + ' people'",
          "as": "total_label"
        },
        {
          "calculate": "format(datum.ksi_share, '.0%')",
          "as": "ksi_label"
        }
      ],
      "layer": [
        {
          "mark": {
            "type": "text",
            "align": "right",
            "dx": -8,
            "fontSize": 13,
            "fontWeight": 600,
            "baseline": "middle"
          },
          "encoding": {
            "x": {
              "datum": 0,
              "type": "quantitative"
            },
            "y": {
              "field": "yc",
              "type": "quantitative"
            },
            "text": {
              "field": "group"
            }
          }
        },
        {
          "mark": {
            "type": "text",
            "align": "left",
            "dx": 8,
            "fontSize": 12,
            "color": "#5B636B",
            "baseline": "middle"
          },
          "encoding": {
            "x": {
              "datum": 1,
              "type": "quantitative"
            },
            "y": {
              "field": "yc",
              "type": "quantitative"
            },
            "text": {
              "field": "total_label"
            }
          }
        },
        {
          "mark": {
            "type": "text",
            "align": "left",
            "dx": 5,
            "fontSize": 12,
            "fontWeight": 700,
            "baseline": "middle",
            "color": "#1E2328"
          },
          "encoding": {
            "x": {
              "field": "ksi_share",
              "type": "quantitative"
            },
            "y": {
              "field": "yc",
              "type": "quantitative"
            },
            "text": {
              "field": "ksi_label"
            }
          }
        }
      ]
    }
  ]
}
