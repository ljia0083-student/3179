{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Ridgeline plot. Each ridge shows how the people killed or seriously injured in one road user group are spread across the 24 hours of the day (share of that group's total, so groups of different sizes can be compared).",
  "data": {
    "url": "data/ksi_user_hour.csv",
    "format": {
      "type": "csv",
      "parse": {
        "hour": "number",
        "people": "number"
      }
    }
  },
  "transform": [
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "people",
          "as": "group_total"
        }
      ],
      "groupby": [
        "road_user"
      ]
    },
    {
      "calculate": "datum.people / datum.group_total",
      "as": "share"
    },
    {
      "calculate": "{'Driver':'Drivers','Passenger':'Passengers','Motorcyclist':'Motorcyclists','Pedestrian':'Pedestrians','Cyclist':'Cyclists'}[datum.road_user]",
      "as": "group"
    },
    {
      "calculate": "datum.hour == 0 ? '12am' : datum.hour < 12 ? datum.hour + 'am' : datum.hour == 12 ? '12pm' : (datum.hour - 12) + 'pm'",
      "as": "hour_label"
    }
  ],
  "spacing": 0,
  "bounds": "flush",
  "config": {
    "view": {
      "stroke": null
    },
    "facet": {
      "spacing": 0
    }
  },
  "facet": {
    "row": {
      "field": "group",
      "type": "nominal",
      "title": null,
      "sort": [
        "Cyclists",
        "Pedestrians",
        "Motorcyclists",
        "Drivers",
        "Passengers"
      ],
      "header": {
        "labels": false
      }
    }
  },
  "spec": {
    "width": 400,
    "height": 56,
    "layer": [
      {
        "mark": {
          "type": "area",
          "interpolate": "monotone",
          "fillOpacity": 0.85,
          "stroke": "#F6F6F4",
          "strokeWidth": 1.5
        },
        "encoding": {
          "x": {
            "field": "hour",
            "type": "quantitative",
            "title": null,
            "scale": {
              "domain": [
                0,
                23
              ],
              "nice": false
            },
            "axis": {
              "values": [
                0,
                3,
                6,
                9,
                12,
                15,
                18,
                21
              ],
              "labelExpr": "datum.value == 0 ? '12am' : datum.value < 12 ? datum.value + 'am' : datum.value == 12 ? '12pm' : (datum.value - 12) + 'pm'",
              "grid": true,
              "gridColor": "#E4E6E3",
              "ticks": false,
              "domain": false
            }
          },
          "y": {
            "field": "share",
            "type": "quantitative",
            "axis": null,
            "scale": {
              "domain": [
                0,
                0.115
              ],
              "range": [
                56,
                -48
              ]
            }
          },
          "fill": {
            "field": "road_user",
            "type": "nominal",
            "legend": null,
            "scale": {
              "domain": [
                "Driver",
                "Passenger",
                "Motorcyclist",
                "Pedestrian",
                "Cyclist"
              ],
              "range": [
                "#3F5A73",
                "#94ABBF",
                "#D98A1F",
                "#7D5BA6",
                "#1F9E8F"
              ]
            }
          },
          "tooltip": [
            {
              "field": "group",
              "title": "Road user"
            },
            {
              "field": "hour_label",
              "title": "Hour starting"
            },
            {
              "field": "share",
              "title": "Share of the group's day",
              "format": ".1%"
            },
            {
              "field": "people",
              "title": "People killed or seriously injured",
              "format": ","
            }
          ]
        }
      },
      {
        "transform": [
          {
            "filter": "datum.hour == 0"
          }
        ],
        "mark": {
          "type": "text",
          "align": "right",
          "baseline": "bottom",
          "dx": -8,
          "dy": -2,
          "fontSize": 13,
          "fontWeight": 600
        },
        "encoding": {
          "x": {
            "datum": 0,
            "type": "quantitative"
          },
          "y": {
            "datum": 0,
            "type": "quantitative"
          },
          "text": {
            "field": "group"
          }
        }
      }
    ]
  },
  "resolve": {
    "scale": {
      "y": "shared"
    }
  }
}