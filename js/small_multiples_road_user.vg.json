{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Small multiples: people killed each year by road user type. Each panel has its own vertical scale so trends within each group are visible.",
  "data": {
    "url": "data/people_killed.csv"
  },
  "transform": [
    {
      "filter": "datum.road_user != 'Other or unknown'"
    },
    {
      "aggregate": [
        {
          "op": "count",
          "as": "killed"
        }
      ],
      "groupby": [
        "year",
        "road_user"
      ]
    },
    {
      "calculate": "{'Driver':'Drivers','Passenger':'Passengers','Motorcyclist':'Motorcyclists','Pedestrian':'Pedestrians','Cyclist':'Cyclists'}[datum.road_user]",
      "as": "group"
    },
    {
      "joinaggregate": [
        {
          "op": "max",
          "field": "year",
          "as": "last_year"
        },
        {
          "op": "min",
          "field": "year",
          "as": "first_year"
        }
      ]
    }
  ],
  "facet": {
    "column": {
      "field": "group",
      "type": "nominal",
      "title": null,
      "sort": [
        "Drivers",
        "Passengers",
        "Motorcyclists",
        "Pedestrians",
        "Cyclists"
      ],
      "header": {
        "labelFontSize": 14,
        "labelFontWeight": 700,
        "labelAnchor": "start",
        "labelPadding": 4
      }
    }
  },
  "resolve": {
    "scale": {
      "y": "independent"
    }
  },
  "spacing": 26,
  "spec": {
    "width": 150,
    "height": 120,
    "encoding": {
      "x": {
        "field": "year",
        "type": "quantitative",
        "title": null,
        "scale": {
          "domain": [
            2010.8,
            2025.2
          ],
          "nice": false
        },
        "axis": {
          "values": [
            2012,
            2018,
            2024
          ],
          "format": "d",
          "ticks": false,
          "domain": false,
          "grid": false,
          "labelFlush": true
        }
      },
      "y": {
        "field": "killed",
        "type": "quantitative",
        "title": null,
        "scale": {
          "zero": true,
          "nice": true
        },
        "axis": {
          "tickCount": 3,
          "ticks": false,
          "domain": false
        }
      },
      "color": {
        "field": "road_user",
        "type": "nominal",
        "scale": {
          "domain": [
            "Driver",
            "Passenger",
            "Motorcyclist",
            "Pedestrian",
            "Cyclist"
          ],
          "range": [
            "#3F5A73",
            "#7E97AD",
            "#D98A1F",
            "#7D5BA6",
            "#1F9E8F"
          ]
        },
        "legend": null
      }
    },
    "layer": [
      {
        "mark": {
          "type": "area",
          "opacity": 0.18,
          "interpolate": "monotone"
        },
        "encoding": {
          "y": {
            "field": "killed",
            "type": "quantitative"
          }
        }
      },
      {
        "mark": {
          "type": "line",
          "strokeWidth": 2,
          "interpolate": "monotone"
        },
        "encoding": {
          "tooltip": [
            {
              "field": "group",
              "title": "Road user"
            },
            {
              "field": "year",
              "title": "Year"
            },
            {
              "field": "killed",
              "title": "People killed"
            }
          ]
        }
      },
      {
        "transform": [
          {
            "filter": "datum.year == datum.last_year || datum.year == datum.first_year"
          }
        ],
        "mark": {
          "type": "point",
          "filled": true,
          "size": 36,
          "opacity": 1
        }
      },
      {
        "transform": [
          {
            "filter": "datum.year == datum.first_year"
          }
        ],
        "mark": {
          "type": "text",
          "dy": -11,
          "align": "left",
          "dx": -3,
          "fontSize": 12,
          "fontWeight": 700
        },
        "encoding": {
          "text": {
            "field": "killed"
          }
        }
      },
      {
        "transform": [
          {
            "filter": "datum.year == datum.last_year"
          }
        ],
        "mark": {
          "type": "text",
          "dy": -11,
          "align": "right",
          "dx": 3,
          "fontSize": 12,
          "fontWeight": 700
        },
        "encoding": {
          "text": {
            "field": "killed"
          }
        }
      }
    ]
  }
}