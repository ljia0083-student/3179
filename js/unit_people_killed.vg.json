{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Unit chart. Each square is one person killed on Victorian roads in the selected year, grouped by road user type. Squares fill columns of ten.",
  "width": 600,
  "height": 210,
  "padding": {
    "top": 34,
    "bottom": 40,
    "left": 0,
    "right": 0
  },
  "data": {
    "url": "data/people_killed.csv"
  },
  "params": [
    {
      "name": "year",
      "value": 2024,
      "bind": {
        "input": "range",
        "min": 2012,
        "max": 2024,
        "step": 1,
        "name": "Year "
      }
    }
  ],
  "transform": [
    {
      "filter": "datum.year == year"
    },
    {
      "calculate": "indexof(['Driver','Passenger','Motorcyclist','Pedestrian','Cyclist','Other or unknown'], datum.road_user)",
      "as": "group_order"
    },
    {
      "window": [
        {
          "op": "row_number",
          "as": "k"
        }
      ],
      "groupby": [
        "road_user"
      ]
    },
    {
      "calculate": "floor((datum.k - 1) / 10)",
      "as": "local_col"
    },
    {
      "calculate": "(datum.k - 1) % 10",
      "as": "row"
    },
    {
      "window": [
        {
          "op": "dense_rank",
          "as": "col_rank"
        }
      ],
      "sort": [
        {
          "field": "group_order"
        },
        {
          "field": "local_col"
        }
      ]
    },
    {
      "window": [
        {
          "op": "dense_rank",
          "as": "group_rank"
        }
      ],
      "sort": [
        {
          "field": "group_order"
        }
      ]
    },
    {
      "calculate": "datum.col_rank + datum.group_rank - 1",
      "as": "col"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "square",
        "size": 180,
        "opacity": 1
      },
      "encoding": {
        "x": {
          "field": "col",
          "type": "quantitative",
          "scale": {
            "domain": [
              0.5,
              37.5
            ]
          },
          "axis": null
        },
        "y": {
          "field": "row",
          "type": "quantitative",
          "scale": {
            "domain": [
              -0.5,
              9.5
            ],
            "reverse": true
          },
          "axis": null
        },
        "color": {
          "field": "road_user",
          "type": "nominal",
          "scale": {
            "domain": [
              "Driver",
              "Passenger",
              "Motorcyclist",
              "Pedestrian",
              "Cyclist",
              "Other or unknown"
            ],
            "range": [
              "#3F5A73",
              "#94ABBF",
              "#D98A1F",
              "#7D5BA6",
              "#1F9E8F",
              "#B9BDC1"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "road_user",
            "title": "Road user"
          },
          {
            "field": "year",
            "title": "Year"
          }
        ]
      }
    },
    {
      "transform": [
        {
          "aggregate": [
            {
              "op": "min",
              "field": "col",
              "as": "x0"
            },
            {
              "op": "count",
              "as": "n"
            },
            {
              "op": "min",
              "field": "group_rank",
              "as": "g"
            }
          ],
          "groupby": [
            "road_user"
          ]
        },
        {
          "calculate": "{'Driver':'Drivers','Passenger':'Passengers','Motorcyclist':'Motorcyclists','Pedestrian':'Pedestrians','Cyclist':'Cyclists','Other or unknown':'Other'}[datum.road_user] + '  ' + datum.n",
          "as": "label"
        },
        {
          "calculate": "datum.g % 2 == 1 ? -1.3 : 10.3",
          "as": "label_y"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": -7,
        "fontSize": 13,
        "fontWeight": 600
      },
      "encoding": {
        "x": {
          "field": "x0",
          "type": "quantitative"
        },
        "y": {
          "field": "label_y",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        },
        "color": {
          "value": "#1E2328"
        }
      }
    }
  ]
}