{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Proportional symbol map. Circle area shows the number of fatal and serious-injury crashes in each council area over the five most recent full years; colour shows whether the council is in Metropolitan Melbourne or Regional Victoria. Click the colour legend to highlight one area.",
  "width": 500,
  "height": 330,
  "projection": {
    "type": "conicEqualArea",
    "parallels": [
      -36,
      -38
    ],
    "rotate": [
      -145,
      0
    ]
  },
  "layer": [
    {
      "data": {
        "url": "data/vic_lga.topojson",
        "format": {
          "type": "topojson",
          "feature": "lga"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#E6E8E4",
        "stroke": "#FFFFFF",
        "strokeWidth": 0.6
      }
    },
    {
      "data": {
        "url": "data/lga_crashes.csv",
        "format": {
          "type": "csv",
          "parse": {
            "lgaCode": "string"
          }
        }
      },
      "transform": [
        {
          "lookup": "lgaCode",
          "from": {
            "data": {
              "url": "data/lga_population.csv",
              "format": {
                "type": "csv",
                "parse": {
                  "lgaCode": "string"
                }
              }
            },
            "key": "lgaCode",
            "fields": [
              "metro"
            ]
          }
        },
        {
          "calculate": "datum.metro == 1 ? 'Metropolitan Melbourne' : 'Regional Victoria'",
          "as": "area"
        },
        {
          "calculate": "replace(datum.lgaName, ' (Vic.)', '')",
          "as": "council"
        }
      ],
      "layer": [
        {
          "params": [
            {
              "name": "area_pick",
              "select": {
                "type": "point",
                "fields": [
                  "area"
                ]
              },
              "bind": "legend"
            }
          ],
          "mark": {
            "type": "circle",
            "stroke": "#FFFFFF",
            "strokeWidth": 0.8
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "size": {
              "field": "ksi_crashes",
              "type": "quantitative",
              "title": "Fatal + serious crashes, 5 years",
              "scale": {
                "range": [
                  0,
                  900
                ]
              },
              "legend": {
                "orient": "none",
                "legendX": 305,
                "legendY": 50,
                "values": [
                  100,
                  500,
                  1000
                ],
                "direction": "horizontal",
                "symbolFillColor": "#B9BDC1",
                "symbolStrokeColor": "#FFFFFF",
                "titleLimit": 200
              }
            },
            "color": {
              "field": "area",
              "type": "nominal",
              "title": null,
              "scale": {
                "domain": [
                  "Metropolitan Melbourne",
                  "Regional Victoria"
                ],
                "range": [
                  "#2F62A8",
                  "#4E8A3A"
                ]
              },
              "legend": {
                "orient": "none",
                "legendX": 305,
                "legendY": 0,
                "symbolType": "circle",
                "symbolSize": 120,
                "labelLimit": 220
              }
            },
            "opacity": {
              "condition": {
                "param": "area_pick",
                "value": 0.78
              },
              "value": 0.12
            },
            "order": {
              "field": "ksi_crashes",
              "sort": "descending"
            },
            "tooltip": [
              {
                "field": "council",
                "title": "Council"
              },
              {
                "field": "area",
                "title": "Area"
              },
              {
                "field": "ksi_crashes",
                "title": "Fatal + serious crashes (5 yrs)",
                "format": ","
              },
              {
                "field": "fatal_crashes",
                "title": "of which fatal",
                "format": ","
              }
            ]
          }
        },
        {
          "mark": {
            "type": "text",
            "fontSize": 11.5,
            "fontWeight": 700,
            "color": "#1E2328",
            "align": "right",
            "dx": -15
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "text": {
              "field": "council"
            }
          },
          "transform": [
            {
              "filter": "datum.council == 'Greater Geelong' || datum.council == 'Ballarat'"
            }
          ]
        },
        {
          "mark": {
            "type": "text",
            "fontSize": 11.5,
            "fontWeight": 700,
            "color": "#1E2328",
            "align": "left",
            "dx": 12
          },
          "encoding": {
            "longitude": {
              "field": "lon",
              "type": "quantitative"
            },
            "latitude": {
              "field": "lat",
              "type": "quantitative"
            },
            "text": {
              "field": "council"
            }
          },
          "transform": [
            {
              "filter": "datum.council == 'Greater Bendigo' || datum.council == 'Latrobe'"
            }
          ]
        }
      ]
    }
  ]
}