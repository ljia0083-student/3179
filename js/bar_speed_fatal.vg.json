{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Bar chart of the share of injury crashes that were fatal, by the posted speed limit where the crash happened (five most recent full years).",
  "width": "container",
  "height": {"step": 34},
  "padding": {"right": 70},
  "data": {"url": "data/speed_zone.csv"},
  "transform": [
    {"calculate": "datum.fatal / datum.crashes", "as": "fatal_share"},
    {"calculate": "datum.speed_limit + ' km/h'", "as": "zone"},
    {"calculate": "'1 in ' + round(datum.crashes / datum.fatal)", "as": "one_in"}
  ],
  "encoding": {
    "y": {
      "field": "zone",
      "type": "ordinal",
      "title": null,
      "sort": {"field": "speed_limit", "order": "ascending"},
      "axis": {"ticks": false, "domain": false, "labelPadding": 8, "labelFontSize": 13}
    },
    "x": {
      "field": "fatal_share",
      "type": "quantitative",
      "title": "Share of injury crashes that killed someone",
      "axis": {"format": "%", "tickCount": 5, "domain": false, "ticks": false, "titleAnchor": "start"},
      "scale": {"domain": [0, 0.055]}
    }
  },
  "layer": [
    {
      "mark": {"type": "bar", "cornerRadiusEnd": 2, "height": {"band": 0.68}},
      "encoding": {
        "color": {
          "condition": {"test": "datum.speed_limit >= 100", "value": "#7F1520"},
          "value": "#D9A493"
        },
        "tooltip": [
          {"field": "zone", "title": "Speed limit"},
          {"field": "crashes", "title": "Injury crashes", "format": ","},
          {"field": "fatal", "title": "Fatal crashes", "format": ","},
          {"field": "serious", "title": "Serious-injury crashes", "format": ","},
          {"field": "fatal_share", "title": "Share fatal", "format": ".1%"}
        ]
      }
    },
    {
      "mark": {"type": "text", "align": "left", "dx": 6, "fontSize": 12.5, "fontWeight": 700, "color": "#1E2328"},
      "encoding": {"text": {"field": "one_in"}}
    }
  ]
}
