{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Bar chart of the share of injury crashes that were fatal, by the posted speed limit where the crash happened (five most recent full years). Bars use the same speed colours as the dot map.",
  "width": "container",
  "autosize": {
    "type": "fit-x",
    "contains": "padding"
  },
  "height": 238,
  "padding": {
    "right": 64
  },
  "data": {
    "url": "data/speed_zone.csv"
  },
  "transform": [
    {
      "calculate": "datum.fatal / datum.crashes",
      "as": "fatal_share"
    },
    {
      "calculate": "datum.speed_limit + ' km/h'",
      "as": "zone"
    },
    {
      "calculate": "'1 in ' + round(datum.crashes / datum.fatal)",
      "as": "one_in"
    },
    {
      "calculate": "datum.speed_limit <= 50 ? '50 km/h or less' : datum.speed_limit == 60 ? '60 km/h' : datum.speed_limit <= 90 ? '70 to 90 km/h' : '100 to 110 km/h'",
      "as": "band"
    }
  ],
  "encoding": {
    "y": {
      "field": "zone",
      "type": "ordinal",
      "title": null,
      "sort": [
        "40 km/h",
        "50 km/h",
        "60 km/h",
        "70 km/h",
        "80 km/h",
        "100 km/h",
        "110 km/h"
      ],
      "axis": {
        "ticks": false,
        "domain": false,
        "labelPadding": 8,
        "labelFontSize": 13
      }
    },
    "x": {
      "field": "fatal_share",
      "type": "quantitative",
      "title": "Share of injury crashes that killed someone",
      "axis": {
        "format": "%",
        "tickCount": 5,
        "domain": false,
        "ticks": false,
        "titleAnchor": "start"
      },
      "scale": {
        "domain": [
          0,
          0.055
        ]
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "cornerRadiusEnd": 2,
        "height": {
          "band": 0.68
        }
      },
      "encoding": {
        "color": {
          "field": "band",
          "type": "ordinal",
          "scale": {
            "domain": [
              "50 km/h or less",
              "60 km/h",
              "70 to 90 km/h",
              "100 to 110 km/h"
            ],
            "range": [
              "#EB883B",
              "#D7530B",
              "#B71C0E",
              "#551016"
            ]
          },
          "legend": null
        },
        "tooltip": [
          {
            "field": "zone",
            "title": "Speed limit"
          },
          {
            "field": "crashes",
            "title": "Injury crashes",
            "format": ","
          },
          {
            "field": "fatal",
            "title": "Fatal crashes",
            "format": ","
          },
          {
            "field": "serious",
            "title": "Serious-injury crashes",
            "format": ","
          },
          {
            "field": "fatal_share",
            "title": "Share fatal",
            "format": ".1%"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 6,
        "fontSize": 12.5,
        "fontWeight": 700,
        "color": "#1E2328"
      },
      "encoding": {
        "text": {
          "field": "one_in"
        }
      }
    }
  ]
}
